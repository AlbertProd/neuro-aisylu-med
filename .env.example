TELEGRAM_BOT_TOKEN=
AI_PROVIDER=vertex
# На сервере используй либо путь к закрытому JSON либо base64 всего JSON в настройках секретов.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_SERVICE_ACCOUNT_BASE64=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Только для отдельного бесплатного аккаунта Tavily без других потребителей этого лимита.
SEARCH_MONTHLY_CREDITS=990
SEARCH_CACHE_MINUTES=15
# Альтернатива Vertex: AI_PROVIDER=gemini использует Gemini Developer API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Коэффициенты для местного бюджета, не банковский курс и не счёт Google.
GEMINI_USD_TO_RUB=100
GEMINI_COST_SAFETY_FACTOR=1.15
# Для прежнего подключения явно укажи AI_PROVIDER=polza.
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=google/gemini-3.8-flash
OWNER_USERNAME=your_telegram_username
# После первого сообщения владельца ID закрепляется в data/aisylu.sqlite.
# Можно заранее указать числовой Telegram ID для доступа без привязки по нику.
OWNER_USER_ID=
DATABASE_PATH=./data/aisylu.sqlite
AI_TIMEOUT_MS=90000
USER_COOLDOWN_SECONDS=4
CHAT_AI_PER_MINUTE=10
GLOBAL_AI_PER_HOUR=120
DAILY_BUDGET_RUB=100
# Поиск и медиа вместе: на весь бот и на участника за сутки по Уфе.
EXPENSIVE_REQUESTS_PER_DAY=10
EXPENSIVE_REQUESTS_PER_USER_DAY=3
# Консервативные резервы до ответа API. Это не гарантия цены со стороны провайдера.
TEXT_REQUEST_RESERVE_RUB=1.5
SEARCH_REQUEST_RESERVE_RUB=4
MEDIA_REQUEST_RESERVE_RUB=3
AI_MAX_OUTPUT_TOKENS=2048
# Максимальные тарифы провайдера в рублях за миллион токенов.
MAX_PROMPT_PRICE_PER_MILLION=60
MAX_COMPLETION_PRICE_PER_MILLION=300
MAX_AUDIO_PRICE_PER_MILLION=60
# По умолчанию сама в разговор не вмешивается. Включение: /ambient on
AMBIENT_PROBABILITY=0.03
AMBIENT_COOLDOWN_SECONDS=900
